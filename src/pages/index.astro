---
import "../styles/global.css";
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Paraat, het vrijwilligersrooster voor Leger des Heils</title>
    <meta
      name="description"
      content="Klaar met puzzelen in Excel. Paraat maakt het weekrooster voor 115 vrijwilligers in minuten, houdt rekening met voorkeuren en laat zien waar plekken open staan."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="hero-light min-h-screen overflow-x-hidden" data-hero-tone="light">
    <!-- ============================ Header ============================ -->
    <header class="site-header fixed inset-x-0 top-0 z-50 border-b" data-scrolled="false">
      <div class="container-wide flex items-center justify-between py-4">
        <a href="#top" class="flex items-center gap-3">
          <img src="/images/ldh/logo.svg" alt="Leger des Heils" class="h-10 w-auto" />
          <span class="flex flex-col leading-none">
            <span class="nav-meta text-lg font-bold tracking-tight text-ink" style="font-family: var(--font-display)">Paraat</span>
            <span class="nav-meta font-mono text-[0.6rem] uppercase tracking-[0.12em] text-ink-faint">Vrijwilligersrooster</span>
          </span>
        </a>
        <nav class="flex items-center gap-7 text-sm">
          <a href="#probleem" class="nav-link hidden font-medium text-ink-muted transition hover:text-ink sm:inline">Het probleem</a>
          <a href="#rooster" class="nav-link hidden font-medium text-ink-muted transition hover:text-ink sm:inline">Hoe het werkt</a>
          <a href="#contact" class="nav-cta rounded-full bg-accent-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-600">Plan een demo</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- ============================ Hero ============================ -->
      <section data-hero="full" class="grain relative flex min-h-[92svh] flex-col overflow-hidden bg-dark text-base">
        <div class="absolute inset-0">
          <div class="reveal-image absolute inset-0">
            <img src="/images/ldh/generated/hero-home.png" alt="Vrijwilligers tijdens een gezamenlijke maaltijd" class="ken-burns h-full w-full object-cover object-center" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-b from-dark/60 via-transparent to-dark"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-dark/85 via-dark/30 to-transparent"></div>
        </div>

        <div class="container-wide relative z-10 flex flex-1 flex-col justify-end pb-16 pt-40 md:pb-24 md:pt-52">
          <div class="max-w-3xl">
            <p class="eyebrow-bone reveal">Vrijwilligersrooster · Leger des Heils</p>
            <h1 class="reveal mt-7 type-display-xl text-base heading-balance">
              Klaar met puzzelen in <span class="font-display-accent text-accent-300">Excel</span>.
            </h1>
            <p class="reveal mt-7 type-lead max-w-xl text-base/85">
              Elke week opnieuw 115 vrijwilligers inroosteren kost je uren. Paraat maakt het
              weekrooster in minuten, houdt rekening met voorkeuren en laat precies zien waar nog
              plekken open staan.
            </p>
            <div class="reveal mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a href="#rooster" class="btn-primary">
                Bekijk hoe het werkt
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
              </a>
              <a href="#contact" class="btn-ghost border-base/30 text-base hover:bg-base/10">Plan een demo</a>
            </div>
          </div>

          <div class="reveal mt-14 flex items-center gap-6">
            <div class="scroll-cue text-base/40"></div>
            <p class="font-mono text-xs uppercase tracking-[0.08em] text-base/55">115 vrijwilligers · 6 diensten · 1 druk op de knop</p>
          </div>
        </div>
      </section>

      <!-- ============================ Probleem ============================ -->
      <section id="probleem" class="section-lg bg-base">
        <div class="container-wide">
          <div class="max-w-[1100px]">
            <p class="eyebrow reveal">Het probleem</p>
            <h2 class="reveal mt-8 type-display-lg text-ink heading-balance">
              Elke week dezelfde <span class="font-display-accent text-accent-500">puzzel</span>.
            </h2>
            <div class="reveal mt-12 grid gap-10 md:mt-16 lg:grid-cols-12">
              <p class="type-lead text-ink-muted lg:col-span-6 lg:col-start-7">
                Namen verschuiven, iemand meldt zich af, twee mensen staan dubbel ingeroosterd, en de
                voorkeuren van vorige week ben je alweer kwijt. Een weekrooster in Excel kost zo drie
                uur. Dat is honderdvijftig uur per jaar die niet naar mensen gaat.
              </p>
            </div>
          </div>

          <div class="reveal-stagger mt-16 grid gap-px overflow-hidden rounded-[1.5rem] border border-ink/10 bg-ink/10 sm:grid-cols-3">
            <div class="bg-base p-7">
              <p class="font-mono text-3xl text-accent-500" style="font-family: var(--font-display); font-weight: 700">~3 uur</p>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">per week kwijt aan handmatig schuiven in Excel.</p>
            </div>
            <div class="bg-base p-7">
              <p class="font-mono text-3xl text-accent-500" style="font-family: var(--font-display); font-weight: 700">115</p>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">vrijwilligers met ieder hun eigen dagen en voorkeuren.</p>
            </div>
            <div class="bg-base p-7">
              <p class="font-mono text-3xl text-accent-500" style="font-family: var(--font-display); font-weight: 700">1 fout</p>
              <p class="mt-3 text-sm leading-relaxed text-ink-muted">en een dienst staat zonder mensen, of iemand dubbel.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================ Beeldband ============================ -->
      <section class="bg-base pb-2 sm:pb-6">
        <div class="container-wide">
          <div class="grid gap-4 sm:gap-5 lg:grid-cols-12">
            <figure class="reveal-image group relative col-span-12 aspect-[16/10] overflow-hidden rounded-[1.5rem] lg:col-span-7">
              <img src="/images/ldh/generated/sfeer-samen.png" alt="Een gesprek bij de koffie in de buurthuiskamer" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.04]" />
              <div class="absolute inset-0 bg-gradient-to-t from-dark/45 to-transparent"></div>
              <figcaption class="absolute bottom-5 left-6 font-mono text-xs uppercase tracking-[0.08em] text-base">Samen</figcaption>
            </figure>
            <figure class="reveal-image group relative col-span-12 aspect-[16/10] overflow-hidden rounded-[1.5rem] lg:col-span-5">
              <img src="/images/ldh/generated/sfeer-helpen.png" alt="Handen sorteren kleding bij de kledingbank" class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-[1.04]" />
              <div class="absolute inset-0 bg-gradient-to-t from-dark/45 to-transparent"></div>
              <figcaption class="absolute bottom-5 left-6 font-mono text-xs uppercase tracking-[0.08em] text-base">Helpen</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- ============================ Interactief rooster ============================ -->
      <section id="rooster" class="section-lg bg-base-2">
        <div class="container-wide">
          <div class="max-w-2xl">
            <p class="eyebrow reveal">Zo werkt het</p>
            <h2 class="reveal mt-6 type-display-md text-ink heading-balance">
              Eén druk op de knop. <span class="font-display-accent text-accent-500">Het hele weekrooster.</span>
            </h2>
            <p class="reveal mt-5 type-lead text-ink-muted">
              Paraat verdeelt je vrijwilligers eerlijk over de diensten, voorkomt dubbele inzet en
              respecteert voorkeuren. Wat overblijft, zie je meteen.
            </p>
          </div>

          <div class="reveal mt-10 overflow-hidden rounded-[1.75rem] border border-ink/10 bg-base shadow-[0_30px_80px_-50px_rgb(28_21_18/0.6)]">
            <!-- Controlebalk -->
            <div class="flex flex-col gap-5 border-b border-ink/10 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
              <div class="flex items-center gap-4">
                <button id="genereer" type="button" class="btn-primary shrink-0">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v6h6M20 20v-6h-6"></path><path d="M20 9a8 8 0 0 0-14-3M4 15a8 8 0 0 0 14 3"></path></svg>
                  <span id="genereer-label">Genereer rooster</span>
                </button>
                <div class="leading-tight">
                  <p class="font-mono text-xs uppercase tracking-[0.08em] text-ink-faint">Week 23</p>
                  <p class="text-sm font-semibold text-ink">Buurtcentrum Vlissingen</p>
                </div>
              </div>
              <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                <div><span id="stat-gevuld" class="font-mono text-xl font-semibold text-ink">0</span><span class="font-mono text-sm text-ink-faint">/0</span><span class="ml-2 font-mono text-[0.65rem] uppercase tracking-[0.08em] text-ink-faint">plekken</span></div>
                <div><span id="stat-open" class="font-mono text-xl font-semibold text-accent-500">0</span><span class="ml-2 font-mono text-[0.65rem] uppercase tracking-[0.08em] text-ink-faint">open</span></div>
                <div><span id="stat-tijd" class="font-mono text-xl font-semibold text-ink">0,0</span><span class="ml-1 font-mono text-sm text-ink-faint">s</span></div>
              </div>
            </div>

            <!-- Roostergrid -->
            <div class="overflow-x-auto p-4 sm:p-6">
              <div id="rooster-grid" class="min-w-[760px]"></div>
            </div>

            <!-- Voetregel -->
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-ink/10 px-5 py-4 sm:px-6">
              <span class="flex items-center gap-2 text-sm text-ink-muted"><span class="h-2.5 w-2.5 rounded-full bg-accent-500"></span> Open plek, nog in te vullen</span>
              <span class="flex items-center gap-2 text-sm text-ink-muted"><span class="h-2.5 w-2.5 rounded-full bg-ink/20"></span> Geen dienst</span>
              <span id="rooster-note" class="text-sm text-ink-faint sm:ml-auto">Voorkeuren gerespecteerd, geen dubbele inzet.</span>
            </div>
          </div>
          <p class="reveal mt-4 text-center font-mono text-xs uppercase tracking-[0.08em] text-ink-faint">In Excel kost dit ongeveer 3 uur. Hier 4 seconden.</p>
        </div>
      </section>

      <!-- ============================ Hoe het werkt ============================ -->
      <section class="section bg-base">
        <div class="container-wide">
          <div class="mb-14 max-w-2xl">
            <p class="eyebrow reveal">In drie stappen</p>
            <h2 class="reveal mt-6 type-display-md text-ink heading-balance">Zo eenvoudig is het opgezet.</h2>
          </div>
          <div class="reveal-stagger grid gap-10 sm:grid-cols-3 lg:gap-8">
            <article>
              <p class="step-num text-3xl">01</p>
              <h3 class="mt-5 font-display text-2xl text-ink leading-tight">Vrijwilligers eenmalig in</h3>
              <p class="mt-4 text-ink-muted leading-relaxed text-[0.95rem]">Namen, beschikbaarheid en voorkeuren staan op één plek. Wijzigen kan altijd, maar hoeft niet elke week.</p>
            </article>
            <article>
              <p class="step-num text-3xl">02</p>
              <h3 class="mt-5 font-display text-2xl text-ink leading-tight">Diensten per week</h3>
              <p class="mt-4 text-ink-muted leading-relaxed text-[0.95rem]">Stel in welke diensten draaien en hoeveel mensen je per dienst nodig hebt. Een vaste week kopieer je zo.</p>
            </article>
            <article>
              <p class="step-num text-3xl">03</p>
              <h3 class="mt-5 font-display text-2xl text-ink leading-tight">Genereer en deel</h3>
              <p class="mt-4 text-ink-muted leading-relaxed text-[0.95rem]">Eén klik maakt het rooster. Jij controleert, vult open plekken aan en deelt het met iedereen.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- ============================ Voordelen ============================ -->
      <section class="section bg-base-2">
        <div class="container-wide">
          <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
            <div class="lg:col-span-6">
              <p class="eyebrow reveal">Wat het oplevert</p>
              <h2 class="reveal mt-6 type-display-md text-ink heading-balance">Minder schuiven, <span class="font-display-accent text-accent-500">eerlijker</span> rooster.</h2>
            </div>
            <p class="reveal type-lead text-ink-muted lg:col-span-5 lg:col-start-8">Niet alleen sneller. Ook eerlijker verdeeld en prettiger voor je vrijwilligers.</p>
          </div>
          <div class="reveal-stagger mt-14 grid gap-px overflow-hidden rounded-[1.5rem] border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-base-2 p-7">
              <p class="font-mono text-xs tracking-[0.08em] text-accent-600">01</p>
              <p class="mt-5 font-display text-xl text-ink">Uren terug</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">Van drie uur naar drie minuten per week.</p>
            </div>
            <div class="bg-base-2 p-7">
              <p class="font-mono text-xs tracking-[0.08em] text-accent-600">02</p>
              <p class="mt-5 font-display text-xl text-ink">Geen dubbele inzet</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">Niemand staat per ongeluk op twee plekken tegelijk.</p>
            </div>
            <div class="bg-base-2 p-7">
              <p class="font-mono text-xs tracking-[0.08em] text-accent-600">03</p>
              <p class="mt-5 font-display text-xl text-ink">Eerlijk verdeeld</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">De last komt evenredig op ieders schouders.</p>
            </div>
            <div class="bg-base-2 p-7">
              <p class="font-mono text-xs tracking-[0.08em] text-accent-600">04</p>
              <p class="mt-5 font-display text-xl text-ink">Voorkeuren tellen mee</p>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted">Liever overdag of dichtbij? Dat zeg je maar één keer.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================ CTA ============================ -->
      <section id="contact" class="grain relative overflow-hidden bg-dark text-base">
        <div class="container-wide section relative z-10">
          <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
            <div class="lg:col-span-7">
              <p class="eyebrow-bone reveal">Minder roosteren</p>
              <h2 class="reveal mt-6 type-display-lg text-base heading-balance">Meer tijd voor <span class="font-display-accent text-accent-300">mensen</span>.</h2>
              <p class="reveal mt-6 type-lead max-w-xl text-base/80">Paraat neemt het puzzelen over, zodat jij je tijd kunt geven aan waar het echt om gaat. We laten het je graag een keer zien met je eigen diensten.</p>
              <div class="reveal mt-9">
                <a href="mailto:hallo@agensea.nl?subject=Demo%20Paraat" class="btn-primary">Plan een demo</a>
              </div>
            </div>
            <div class="reveal lg:col-span-4 lg:col-start-9">
              <div class="grid grid-cols-3 gap-px overflow-hidden rounded-2xl border border-base/15 bg-base/10 text-center">
                <div class="bg-dark px-3 py-6"><p class="font-display text-2xl font-bold text-base">3u</p><p class="mt-1 font-mono text-[0.6rem] uppercase tracking-[0.08em] text-base/55">naar 3min</p></div>
                <div class="bg-dark px-3 py-6"><p class="font-display text-2xl font-bold text-base">115</p><p class="mt-1 font-mono text-[0.6rem] uppercase tracking-[0.08em] text-base/55">vrijwilligers</p></div>
                <div class="bg-dark px-3 py-6"><p class="font-display text-2xl font-bold text-base">0</p><p class="mt-1 font-mono text-[0.6rem] uppercase tracking-[0.08em] text-base/55">dubbel</p></div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-base/10 bg-dark text-base/55">
      <div class="container-wide flex flex-col gap-3 py-9 text-sm sm:flex-row sm:items-center sm:justify-between">
        <span class="flex items-center gap-3 text-base">
          <img src="/images/ldh/logo.svg" alt="Leger des Heils" class="h-9 w-auto" />
          <span class="font-display font-bold text-base">Paraat</span>
        </span>
        <p class="max-w-md sm:text-right">Onafhankelijke demo van Agensea in de huisstijl van Leger des Heils. Geen officiële uiting van de organisatie.</p>
      </div>
    </footer>

    <script>
      import { bootMotion } from "../lib/motion";
      bootMotion();

      // =====================================================================
      // Paraat, interactief weekrooster. Vult vrijwilligers eerlijk over de
      // diensten, voorkomt dubbele inzet per dag, markeert open plekken.
      // =====================================================================

      const DAGEN = ["Ma", "Di", "Wo", "Do", "Vr", "Za", "Zo"];
      const DIENSTEN = [
        { naam: "Buurthuiskamer", need: [3, 3, 3, 3, 3, 2, 0] },
        { naam: "Maaltijdvoorziening", need: [4, 4, 4, 4, 4, 4, 3] },
        { naam: "Kledingbank", need: [0, 2, 0, 2, 0, 2, 0] },
        { naam: "Voedselpakketten", need: [0, 0, 3, 0, 3, 0, 0] },
        { naam: "Receptie en onthaal", need: [1, 1, 1, 1, 1, 0, 0] },
        { naam: "Chauffeursdienst", need: [1, 1, 1, 1, 1, 1, 0] },
      ];
      const POOL = ["Annelies V","Mark B","Fatima E","Henk J","Sanne K","Youssef A","Greetje M","Tom V","Ridwan H","Petra S","Johan D","Linda W","Kees P","Amira N","Bram T","Joke L","Erik H","Nadia B","Wim G","Saskia V","Mohammed K","Truus D","Daan R","Ingrid M","Cor V","Esther P","Bilal Y","Marga H","Jan W","Hester K","Ali R","Corrie B","Dirk J","Yvonne S","Faisal M","Riet V"];

      const initialen = (n: string) => n.split(" ").map((p) => p[0]).join("").slice(0, 2).toUpperCase();
      const shuffle = (arr: string[]) => { const a = arr.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };

      const grid = document.getElementById("rooster-grid")!;
      const btn = document.getElementById("genereer") as HTMLButtonElement;
      const btnLabel = document.getElementById("genereer-label")!;
      const statGevuld = document.getElementById("stat-gevuld")!;
      const statOpen = document.getElementById("stat-open")!;
      const statTijd = document.getElementById("stat-tijd")!;
      const note = document.getElementById("rooster-note")!;

      type Cell = { need: number; namen: string[] };

      function plan(): { rows: Cell[][]; totalSlots: number; filled: number } {
        const rows: Cell[][] = [];
        let totalSlots = 0;
        let filled = 0;
        // Per dag bijhouden wie al ingezet is, zodat niemand dubbel staat.
        const perDagInzet: Set<string>[] = DAGEN.map(() => new Set<string>());

        // Bewust een paar plekken openlaten zodat de tool laat zien waar nog gaten zitten.
        const totaalNodig = DIENSTEN.reduce((s, d) => s + d.need.reduce((a, b) => a + b, 0), 0);
        const openDoel = 3 + Math.floor(Math.random() * 2); // 3 of 4 open plekken
        const openSet = new Set<number>();
        while (openSet.size < openDoel) openSet.add(Math.floor(Math.random() * totaalNodig));

        let slotIndex = 0;
        for (const dienst of DIENSTEN) {
          const row: Cell[] = [];
          for (let d = 0; d < DAGEN.length; d++) {
            const need = dienst.need[d];
            const namen: string[] = [];
            if (need > 0) {
              totalSlots += need;
              const beschikbaar = shuffle(POOL).filter((n) => !perDagInzet[d].has(n));
              let bi = 0;
              for (let s = 0; s < need; s++) {
                const isOpen = openSet.has(slotIndex);
                slotIndex++;
                if (isOpen || bi >= beschikbaar.length) continue; // open laten
                const naam = beschikbaar[bi++];
                perDagInzet[d].add(naam);
                namen.push(naam);
                filled++;
              }
            }
            row.push({ need, namen });
          }
          rows.push(row);
        }
        return { rows, totalSlots, filled };
      }

      function render(data: { rows: Cell[][]; totalSlots: number; filled: number }) {
        let i = 0; // globale chip-index voor de stagger
        const head =
          `<div class="grid grid-cols-[150px_repeat(7,1fr)] gap-2">` +
          `<div></div>` +
          DAGEN.map((d) => `<div class="pb-2 text-center font-mono text-[0.7rem] uppercase tracking-[0.08em] text-ink-faint">${d}</div>`).join("") +
          `</div>`;

        const body = data.rows
          .map((row, r) => {
            const cells = row
              .map((cell) => {
                if (cell.need === 0) {
                  return `<div class="flex min-h-[52px] items-center justify-center rounded-xl bg-ink/[0.03] text-ink/20">·</div>`;
                }
                const chips = cell.namen
                  .map((n) => `<span class="chip" style="--i:${i++}" title="${n}">${initialen(n)}</span>`)
                  .join("");
                const open = cell.need - cell.namen.length;
                const openPill = open > 0 ? `<span class="chip chip-open" style="--i:${i++}">+${open}</span>` : "";
                return `<div class="flex min-h-[52px] flex-wrap content-center gap-1 rounded-xl border p-1.5 ${open > 0 ? "border-accent-500/40 bg-accent-500/[0.04]" : "border-ink/10 bg-base"}">${chips}${openPill}</div>`;
              })
              .join("");
            return `<div class="grid grid-cols-[150px_repeat(7,1fr)] items-stretch gap-2 ${r > 0 ? "mt-2" : ""}">` +
              `<div class="flex items-center pr-2 text-sm font-semibold text-ink">${DIENSTEN[r].naam}</div>` +
              cells +
              `</div>`;
          })
          .join("");

        grid.innerHTML = head + body;
      }

      function countUp(el: HTMLElement, to: number, opts: { decimals?: number; suffix?: string } = {}) {
        const { decimals = 0, suffix = "" } = opts;
        const dur = 900;
        const start = performance.now();
        function step(now: number) {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          const val = (to * eased).toFixed(decimals).replace(".", ",");
          el.textContent = val + suffix;
          if (t < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      let busy = false;
      function genereer() {
        if (busy) return;
        busy = true;
        btn.disabled = true;
        btnLabel.textContent = "Bezig met puzzelen...";
        note.textContent = "Vrijwilligers verdelen over de diensten...";

        window.setTimeout(() => {
          const data = plan();
          render(data);
          const open = data.totalSlots - data.filled;
          statGevuld.textContent = "0";
          countUp(statGevuld, data.filled);
          // toon noemer
          const gevuldWrap = statGevuld.nextElementSibling as HTMLElement;
          if (gevuldWrap) gevuldWrap.textContent = "/" + data.totalSlots;
          countUp(statOpen, open);
          countUp(statTijd, 4.2, { decimals: 1 });
          note.textContent = open > 0 ? `${open} open plekken om nog in te vullen.` : "Volledig gevuld.";

          btnLabel.textContent = "Genereer opnieuw";
          btn.disabled = false;
          busy = false;
        }, 620);
      }

      btn.addEventListener("click", genereer);

      // Automatisch genereren zodra het rooster in beeld komt.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { genereer(); io.disconnect(); }
        }
      }, { threshold: 0.3 });
      io.observe(document.getElementById("rooster")!);
    </script>

    <style is:global>
      .chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.85rem;
        height: 1.85rem;
        padding: 0 0.4rem;
        border-radius: 0.55rem;
        background: var(--color-base-2);
        border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
        font-family: var(--font-mono);
        font-size: 0.66rem;
        font-weight: 500;
        color: var(--color-ink-soft);
        opacity: 0;
        transform: translateY(6px) scale(0.9);
        animation: chipIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: calc(var(--i) * 16ms);
      }
      .chip-open {
        background: var(--color-accent-500);
        border-color: transparent;
        color: #fff;
      }
      @keyframes chipIn {
        to { opacity: 1; transform: translateY(0) scale(1); }
      }
      @media (prefers-reduced-motion: reduce) {
        .chip { animation: none; opacity: 1; transform: none; }
      }
    </style>
  </body>
</html>
